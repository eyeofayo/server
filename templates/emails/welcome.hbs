{{#> layout title=(concat "Welcome to " appName) preheader="Your account is ready." reason=(concat "because a " appName " account was made with this address")}}
<p style="margin:0 0 16px 0;">Hi {{firstName}},</p>
<p style="margin:0;">Your account is ready. Sign in with <strong>{{email}}</strong> or your username.</p>
{{> button url=loginUrl label=(concat "Open " appName)}}
{{/layout}}
