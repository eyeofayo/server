# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

# Application name (used in logs, emails, and 2FA setup)
APP_NAME=App Base

# Server port (Render sets this automatically in production)
PORT=8080

# Environment mode: development, production, or test
NODE_ENV=development


# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# MongoDB Atlas connection string
# Replace: username, password, cluster.example.mongodb.net, database-name, app-name
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database-name?retryWrites=true&w=majority&appName=app-name


# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================

# JWT Access Token Secret (generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_TOKEN_SECRET=replace_with_random_generated_secret_at_least_32_chars_long

# JWT Refresh Token Secret (generate a different secret from access token)
REFRESH_TOKEN_SECRET=replace_with_different_random_generated_secret_at_least_32_chars_long

# Token expiration times (format: 20m, 1h, 7d, etc.)
ACCESS_TOKEN_EXPIRY=20m
REFRESH_TOKEN_EXPIRY=7d
# bcrypt cost factor for password hashing. Do not lower this in production.
BCRYPT_ROUNDS=12



# ==============================================================================
# REDIS CACHE CONFIGURATION
# ==============================================================================

# Enable or disable Redis caching (true/false)
CACHE_ENABLED=true

# Redis connection URL (supports local and cloud deployments)
REDIS_URL=redis://localhost:6379

# Cache cleanup service configuration
CACHE_CLEANUP_ENABLED=true
CACHE_CLEANUP_INTERVAL_HOURS=24
CACHE_CLEANUP_MIN_AGE_HOURS=2
CACHE_CLEANUP_MAX_KEYS_PER_RUN=500


# ==============================================================================
# REQUEST LIMITS
# ==============================================================================

# Maximum request payload size (controls file upload limit)
MAX_REQUEST_SIZE=500mb


# ==============================================================================
# RATE LIMITING
# ==============================================================================

# General API rate limiting (applies to /api/* routes)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Authentication rate limiting (applies to /api/v1/auth/* routes)
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX_REQUESTS=100


# ==============================================================================
# LOGGING
# ==============================================================================

# Log level (options: error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=http


# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================

# Allowed origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8082,http://localhost:8083,http://localhost:8088


# ==============================================================================
# EMAIL SERVICE (SMTP)
# ==============================================================================

# Enable or disable email service (true/false)
EMAIL_ENABLED=true

# SMTP server configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your_email_password_or_app_password

# Email sender address
EMAIL_FROM=noreply@example.com

# Application URL (used in email links for verification, password reset, etc.)
APP_URL=http://localhost:8083 # Development (frontend URL)

# =
# BILLING (STRIPE)
# =

# Optional. Leave both empty and the app has no billing at all. Set both and people can buy prepaid credit
# on Stripe's own checkout page. Use test-mode keys (sk_test_...) everywhere but production.
# The secret key is from Stripe's dashboard (Developers > API keys). The webhook secret (whsec_...) is shown
# when the endpoint <server address>/api/v1/billing/stripe is added under Developers > Webhooks, with the events
# checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded, charge.dispute.created
# and charge.dispute.closed.
# The Stripe account may be shared with other projects: everything this app makes there carries its own mark
# (metadata service and project), and it acts only on messages that carry it. A restricted key (rk_test_...) is
# enough: it needs to write Checkout Sessions and Refunds. A live key is refused unless NODE_ENV is production.
# On one computer, `stripe listen --forward-to localhost:<port>/api/v1/billing/stripe` passes Stripe's messages on
# and prints the webhook secret to use.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. The publishable key (pk_test_... in test mode) from the same page. With it, people pay inside the
# app's Billing page: Stripe's card field sits in the page and the app's own button pays. Without it, they pay on
# Stripe's checkout page. It is not a secret: the web app is given it to load Stripe's card field.
STRIPE_PUBLISHABLE_KEY=
